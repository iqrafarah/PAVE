<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>nl.fontys.pave</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pave</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>PAVE gebruikt de camera om een document te scannen, zoals een certificaat. De tekst wordt op je toestel gelezen; alleen die tekst gaat met je bericht naar Ayla.</string>
	<key>NSContactsUsageDescription</key>
	<string>PAVE kijkt welke e-mails van mensen uit je contacten komen, zodat alleen die bij je meldingen staan. Je contacten blijven op je iPhone.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>PAVE gebruikt Face ID om de app te ontgrendelen, zodat je je pincode niet hoeft in te typen.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PAVE gebruikt de microfoon zodat je je vraag aan Ayla kunt inspreken of met haar kunt praten.</string>
	<key>NSMotionUsageDescription</key>
	<string>Met AirPods in kun je Ayla ja en nee antwoorden door te knikken of je hoofd te schudden. PAVE volgt je hoofd alleen als Ayla zo'n vraag stelt, en alleen op je toestel.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>PAVE zet wat je inspreekt om in tekst, zodat Ayla je vraag kan lezen. Dat gebeurt op je toestel als dat kan, anders via Apple.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSUserActivityTypes</key>
	<array>
		<string>nl.fontys.pave.conversation</string>
	</array>
	<key>PaveKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(APP_BUNDLE_IDENTIFIER).shared</string>
	<key>SupabasePublishableKey</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<key>PaveWebURL</key>
	<string>$(PAVE_WEB_URL)</string>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>InterVariable.ttf</string>
		<string>SoraVariable.ttf</string>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>waveform</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Praat met Ayla</string>
			<key>UIApplicationShortcutItemType</key>
			<string>praat-met-ayla</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>bubble.left.fill</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Nieuw gesprek</string>
			<key>UIApplicationShortcutItemType</key>
			<string>nieuw-gesprek</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>nl.fontys.pave.notifications-refresh</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Canvas</string>
	</dict>
</dict>
</plist>
