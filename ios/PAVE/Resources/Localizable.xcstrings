    "Pas je de gegevens of bestanden aan, dan staat het weer als Niet bevestigd in je kluis. Daarna kun je opnieuw bevestiging aanvragen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you change the details or files, it goes back to Not confirmed in your vault. You can then request confirmation again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Si bo kambia e datonan òf archivonan, e ta bolbe riba No konfirmá den bo kaha fuerte. Despues bo por pidi konfirmashon atrobe."
          }
        }
      }
    },
