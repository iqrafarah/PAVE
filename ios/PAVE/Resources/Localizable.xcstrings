    },
    "Zal ik dit onthouden?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall I remember this?"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi mester kòrda esaki?"
          }
        }
      }
    },
    "Zal ik dit over je onthouden?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall I remember this about you?"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi mester kòrda esaki di bo?"
          }
        }
      }
    },
    "Zal ik dit weghalen?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall I remove this?"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi mester kita esaki?"
          }
        }
      }
    },
    "Ze kunnen je %@ bewijsstukken en de bestanden inzien, twee weken lang. Stoppen kan altijd bij Profiel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can view your %@ pieces of evidence and the files for two weeks. You can always stop in Profile."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Nan por wak bo %@ prueba i e archivonan, pa dos siman. Bo por stop semper na Perfil."
          }
        }
      }
    },
    "Ze kunnen je bewijsstuk en de bestanden inzien, twee weken lang. Stoppen kan altijd bij Profiel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can view your piece of evidence and the files for two weeks. You can always stop in Profile."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Nan por wak bo prueba i e archivonan, pa dos siman. Bo por stop semper na Perfil."
          }
        }
      }
    },
    "Ze ziet geen bewijs uit je kluis: daar gaf je geen toestemming voor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "She doesn't see any evidence from your vault: you didn't give permission for that."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "E no ta mira ningun prueba for di bo kaha fuerte: bo no a duna permiso pa esei."
          }
        }
      }
    },
    "Zeg \"Praat met Ayla in PAVE\" om verder te gaan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say \"Talk to Ayla in PAVE\" to continue."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisa \"Papia ku Ayla den PAVE\" pa sigui."
          }
        }
      }
    },
    "Zeg eerst dat je komt, dan zet ik het gesprek in je agenda.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First say you're coming, then I'll put the interview in your calendar."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisa promé ku bo ta bini, anto mi ta pone e entrevista den bo kalender."
          }
        }
      }
    },
    "Zeg het, of knik ja of schud nee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say it, or nod yes or shake no"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis'é, òf hasi si òf nò ku bo kabes"
          }
        }
      }
    },
    "Zeg ja of nee, of knik of schud je hoofd.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say yes or no, or nod or shake your head."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisa si òf nò, òf hasi si òf nò ku bo kabes."
          }
        }
      }
    },
    "Zeg ja of nee.": {
      "extractionState": "manual",
      "localizations": {
