            "state": "translated",
            "value": "Mi a añadí %@ foto na %@."
          }
        }
      }
    },
    "Ik heb %@ laten weten dat je komt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've let %@ know you're coming."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi a laga %@ sa ku bo ta bini."
          }
        }
      }
    },
    "Ik heb %@ laten weten dat je komt. Ik open je agenda: bewaar het gesprek daar als je wilt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've let %@ know you're coming. I'm opening your calendar: save the interview there if you like."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi a laga %@ sa ku bo ta bini. Mi ta habri bo kalender: warda e entrevista einan si bo ke."
          }
        }
      }
    },
    "Ik heb %@ laten weten dat je niet kunt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've let %@ know you can't make it."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi a laga %@ sa ku bo no por."
          }
        }
      }
    },
    "Ik heb %@ uit je kluis verwijderd.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've deleted %@ from your vault."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi a kita %@ for di bo kaha fuerte."
          }
        }
      }
    },
    "Ik heb alles vergeten wat ik over je onthield.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've forgotten everything I remembered about you."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi a lubidá tur loke mi tabata kòrda di bo."
          }
        }
      }
    },
    "Ik heb de stap %@ bijgewerkt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
