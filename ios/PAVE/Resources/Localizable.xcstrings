    "Ayla kan vaardigheden voorstellen die bij dit bewijs passen. Ze kijkt naar wat je invulde en naar je bestanden, alleen voor dit voorstel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla can suggest skills that fit this evidence. She looks at what you filled in and at your files, only for this suggestion."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla por sugerí abilidatnan ku ta kuadra ku e prueba aki. E ta wak loke bo a yena i bo archivonan, solamente pa e sugerensia aki."
          }
        }
      }
    },
