          }
        }
      }
    },
    "Ayla maakt van je tekst een net antwoord op deze mail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla turns your text into a neat reply to this email"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta hasi di bo teksto un kontesta nèt riba e e-mail aki"
          }
        }
      }
    },
    "Ayla mag %@ van deze items nog niet gebruiken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla isn't allowed to use %@ of these items yet"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no mag usa %@ di e ítemnan aki ainda"
          }
        }
      }
    },
    "Ayla mag dingen onthouden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla may remember things"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla mag kòrda kosnan"
          }
        }
      }
    },
    "Ayla mag dit bewijs bekijken en gebruiken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla may view and use this evidence"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla mag wak i usa e prueba aki"
          }
        }
      }
    },
    "Ayla mag dit bewijs nog niet gebruiken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla isn't allowed to use this evidence yet"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no mag usa e prueba aki ainda"
          }
        }
      }
    },
    "Ayla mag dit document bekijken en gebruiken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla may view and use this document"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla mag wak i usa e dokumento aki"
          }
        }
      }
    },
    "Ayla mag dit niet bekijken en schrijft er niet over": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla isn't allowed to view this and won't write about it"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no mag wak esaki i lo no skirbi tokante dje"
          }
        }
      }
    },
    "Ayla mag je archief gebruiken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla may use your archive"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla mag usa bo archivo"
          }
        }
      }
    },
    "Ayla mag nog geen bewijs uit je kluis bekijken, dus ze schrijft algemeen. Zet bij een bewijsstuk \"Ayla mag dit bekijken en gebruiken\" aan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla isn't allowed to view evidence from your vault yet, so she writes in general terms. Turn on \"Ayla may view and use this\" on a piece of evidence."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no mag wak prueba for di bo kaha fuerte ainda, p'esei e ta skirbi na un manera general. Pone \"Ayla mag wak i usa esaki\" na un prueba."
          }
        }
      }
    },
    "Ayla onthoudt %@ dingen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla remembers %@ things"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta kòrda %@ kos"
          }
        }
      }
    },
    "Ayla onthoudt 1 ding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla remembers 1 thing"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta kòrda 1 kos"
          }
        }
      }
    },
    "Ayla onthoudt nog niets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla doesn't remember anything yet"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no ta kòrda nada ainda"
          }
        }
      }
    },
    "Ayla onthoudt nog niets over je. Vertel het haar, dan vraagt ze of ze het mag onthouden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla doesn't remember anything about you yet. Tell her, and she'll ask if she may remember it."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ainda no ta kòrda nada di bo. Kont'é, anto e ta puntra si e mag kòrd'é."
          }
        }
      }
    },
    "Ayla onthoudt nog niets over je. Vertel je in een gesprek iets wat later handig is, zoals je opleiding of een doel, dan vraagt ze of ze het mag onthouden. Je kunt ook zelf iets toevoegen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla doesn't remember anything about you yet. If you mention something in a conversation that's useful later, like your education or a goal, she'll ask whether she can remember it. You can also add something yourself."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no ta kòrda nada di bo ainda. Si den un kombersashon bo konta algu ku ta util despues, manera bo estudio òf un meta, e ta puntra si e mag kòrda esaki. Bo por añadí algu bo mes tambe."
          }
        }
      }
    },
    "Ayla onthoudt nu niets. Je kunt dit aanzetten op je iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla isn't remembering anything now. You can turn this on on your iPhone."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no ta kòrda nada awor. Bo por pone esaki na riba bo iPhone."
          }
        }
      }
    },
    "Ayla praat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is talking"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta papiando"
          }
        }
      }
    },
    "Ayla schrijft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla writes"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta skirbi"
          }
        }
      }
    },
    "Ayla schrijft een antwoord…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is writing a reply…"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta skirbiendo un kontesta…"
          }
        }
      }
    },
    "Ayla schrijft je verslag…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is writing your report…"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta skirbiendo bo informe…"
          }
        }
      }
    },
    "Ayla schrijft mee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla helps write"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta yuda skirbi"
          }
        }
      }
    },
    "Ayla schrijft…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is writing…"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta skirbiendo…"
          }
        }
      }
    },
    "Ayla stelt stappen voor bij je doel. Jij kiest welke je houdt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla suggests steps for your goal. You choose which ones to keep."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta sugerí pasonan pa bo meta. Abo ta skohe kua bo ta keda ku nan."
          }
        }
      }
    },
    "Ayla stelt voor wat ze onthoudt en jij beslist. Ze gebruikt het in je gesprekken op je iPhone, het web en je Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla suggests what to remember and you decide. She uses it in your conversations on your iPhone, the web and your Apple Watch."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta sugerí kiko e ta kòrda i bo ta disidí. E ta us'é den bo kombersashonnan riba bo iPhone, web i bo Apple Watch."
          }
        }
      }
    },
    "Ayla vergeet alles wat hier staat, ook op het web. Dit kun je niet ongedaan maken.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla forgets everything here, on the web too. You can't undo this."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta lubidá tur loke ta aki, tambe riba web. Bo no por deshasí esaki."
          }
        }
      }
    },
    "Ayla vergeleek je kluis met een stukje van de vacaturetekst. Het is een inschatting, geen oordeel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla compared your vault with a snippet of the vacancy text. It's an estimate, not a judgement."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla a kompará bo kaha fuerte ku un pida di e teksto di e vakatura. Ta un estimashon, no un huisio."
          }
        }
      }
    },
    "Ayla vergelijkt %@ met je kluis…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is comparing %@ with your vault…"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta kompará %@ ku bo kaha fuerte…"
          }
        }
      }
    },
    "Ayla vergelijkt %@ met wat je koos…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is comparing %@ with what you chose…"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta kompará %@ ku loke bo a skohe…"
          }
        }
      }
    },
    "Ayla vertelt in de chat waarom deze vacature bij je past en wat je nog mist": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla explains in the chat why this vacancy suits you and what you're still missing"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta splika den e chat dikon e vakatura aki ta kuadra ku bo i kiko ainda ta falta"
          }
        }
      }
    },
    "Ayla volgt dit in elke chat binnen dit project, bijvoorbeeld waar het over gaat of hoe ze moet antwoorden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla follows this in every chat in this project, for example what it's about or how she should answer."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta sigui esaki den tur chat den e proyekto aki, por ehèmpel di kiko e ta trata òf kon e mester kontestá."
          }
        }
      }
    },
    "Ayla vond geen logo of omslag. Wil je er zelf een kiezen?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla found no logo or cover. Do you want to choose one yourself?"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no a haña logo òf portada. Bo ke skohe un bo mes?"
          }
        }
      }
    },
    "Ayla vond geen logo. Wil je er zelf een kiezen?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla found no logo. Do you want to choose one yourself?"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no a haña logo. Bo ke skohe un bo mes?"
          }
        }
      }
    },
    "Ayla vond geen nieuwe vaardigheden in dit bewijs. Vul de omschrijving aan of voeg een bestand toe en vraag het opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla found no new skills in this evidence. Add to the description or add a file and ask again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no a haña abilidat nobo den e prueba aki. Kompletá e deskripshon òf añadí un archivo i puntra atrobe."
          }
        }
      }
    },
    "Ayla vond niets betrouwbaars over %@. Kijk anders op de website van het bedrijf.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla found nothing reliable about %@. Check the company's website instead."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no a haña nada konfiabel tokante %@. Wak riba e website di e kompania mas bien."
          }
        }
      }
    },
    "Ayla vult het in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla fills it in"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta yena esaki"
          }
        }
      }
    },
    "Ayla wacht tot je klaar bent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla waits until you're done"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta warda te ora bo kaba"
          }
        }
      }
    },
    "Ayla werkt alleen als je met je eigen PAVE-account bent ingelogd.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla only works when you're signed in with your own PAVE account."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta funshoná solamente ora bo ta drentá ku bo mes kuenta di PAVE."
          }
        }
      }
    },
    "Ayla ziet %@ bewijzen in je bestanden; je kiest in de volgende stap of je ze apart toevoegt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla sees %@ pieces of evidence in your files; in the next step you choose whether to add them separately."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta mira %@ prueba den bo archivonan; den e siguiente paso bo ta skohe si bo ta añadí nan aparte."
          }
        }
      }
    },
    "Ayla ziet %@ bewijzen: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla sees %@ pieces of evidence: %@."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta mira %@ prueba: %@."
          }
        }
      }
    },
    "Ayla zoekt het op: %@…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is looking it up: %@…"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta buska esaki: %@…"
          }
        }
      }
    },
    "Ayla zoekt je punten…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is finding your points…"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta buska bo puntonan…"
          }
        }
      }
    },
    "Ayla zoekt op het web wat er voor een sollicitant toe doet. Alleen de naam en de plaats van het bedrijf gaan mee, niets over jou.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla searches the web for what matters to an applicant. Only the company's name and location are sent, nothing about you."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta buska riba web kiko ta importante pa un solisitante. Solamente e nòmber i lugá di e kompania ta bai huntu, nada tokante bo."
          }
        }
      }
    },
    "Ayla zoekt op wat er over %@ te vinden is…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is looking up what can be found about %@…"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta buska kiko por haña tokante %@…"
          }
        }
      }
    },
    "Ayla zoekt opleidingen: %@ in %@…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is looking up studies: %@ in %@…"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta buska estudio: %@ na %@…"
          }
        }
      }
    },
    "Ayla zoekt opleidingen: %@…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla is looking up studies: %@…"
