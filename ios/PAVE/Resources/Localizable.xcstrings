            "state": "translated",
            "value": "You gave a final presentation"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo a duna un presentashon final"
          }
        }
      }
    },
    "Je gedeelde profielen konden niet worden geladen. Probeer het zo opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
