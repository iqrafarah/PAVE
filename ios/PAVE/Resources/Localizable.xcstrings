    "Controleer alles voordat je verdergaat. Wat Ayla niet in je bestand zag, is leeg gebleven.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check everything before you continue. What Ayla didn't see in your file has been left empty."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolá tur kos promé ku bo sigui. Loke Ayla no a mira den bo archivo a keda bashí."
          }
        }
      }
    },
    "Controleer en deel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
