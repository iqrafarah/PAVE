    "Sta je het toe, dan kan Ayla dit bewijs meenemen in je vragen en zoekopdrachten. Je kunt het altijd weer uitzetten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you allow it, Ayla can include this evidence in your questions and searches. You can always turn it off again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Si bo permití esaki, Ayla por usa e prueba aki den bo preguntanan i búskedanan. Bo por pag'é atrobe semper."
          }
        }
      }
    },
