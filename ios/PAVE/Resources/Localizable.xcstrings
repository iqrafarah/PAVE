    },
    "Je bewaarde vacatures konden niet worden geladen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved vacancies couldn't be loaded."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "No por a karga bo vakaturanan wardá."
          }
        }
      }
    },
    "Je bewijs blijft in je kluis; de ontvanger ziet het zoals het daar nu staat. Wat je apart deelt, zoals je cv, wist PAVE zodra delen stopt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your evidence stays in your vault; the recipient sees it as it is there now. What you share separately, such as your CV, PAVE erases as soon as sharing stops."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo prueba ta keda den bo kaha fuerte; e risibidó ta mir'é manera e ta einan awor. Loke bo kompartí aparte, manera bo CV, PAVE ta borá ora kompartimentu stop."
          }
        }
      }
    },
    "Je bewijs staat in je kluis. %@ nog niet bewaard worden; dat komt binnenkort.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your evidence is in your vault. %@ be saved yet; that's coming soon."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo prueba ta den bo kaha fuerte. %@ wòrdu wardá ainda; esei ta bini pronto."
          }
        }
      }
    },
    "Je brief is %@ pagina's. Een brief past het best op één pagina.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your letter is %@ pages. A letter works best on one page."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo karta tin %@ página. Un karta ta kuadra mihó riba un página."
          }
        }
      }
    },
    "Je chats blijven bestaan, ze horen alleen niet meer bij een project.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chats remain, they just no longer belong to a project."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo chats ta keda, nan solamente no ta pertenesé mas na un proyekto."
          }
        }
      }
    },
    "Je chats konden niet worden geladen. Controleer je internetverbinding en probeer het opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chats couldn't be loaded. Check your internet connection and try again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "No por a karga bo chats. Kontrolá bo konekshon di internet i purba atrobe."
          }
        }
      }
    },
    "Je chats zijn niet meer vindbaar in iPhone-zoeken.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chats can no longer be found in iPhone search."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo chats no por wòrdu buská mas den buskadó di iPhone."
          }
        }
      }
    },
    "Je chats zijn nu vindbaar in iPhone-zoeken.": {
