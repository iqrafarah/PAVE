    },
    "Hoe lang?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long?"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuantu tempu?"
          }
        }
      }
    },
    "Hoeft niet. Ayla legt hier de nadruk op in je profiel en brief, voor zover je bewijs dat laat zien.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not required. Ayla emphasises this in your profile and letter, as far as your evidence shows it."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "No ta nesesario. Ayla ta pone énfasis riba esaki den bo perfil i karta, segun loke bo prueba ta mustra."
          }
        }
      }
    },
    "Hoeveel laat je zien": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much you show"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuantu bo ta mustra"
