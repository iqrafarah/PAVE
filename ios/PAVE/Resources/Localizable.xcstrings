            "state": "translated",
            "value": "Manera na Konfigurashon"
          }
        }
      }
    },
    "Zodra een organisatie je bewijs beoordeelt, zie je dat hier.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once an organisation reviews your evidence, you'll see it here."
          }
        },
        "pap": {
