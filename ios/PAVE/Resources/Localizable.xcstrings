          }
        }
      }
    },
    "Je hebt geen vergrendelde chats. Kies Chat vergrendelen in het menu van een chat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no locked chats. Choose Lock chat in a chat's menu."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo no tin chats bloká. Skohe Bloká chat den e menú di un chat."
          }
        }
      }
    },
    "Je hebt gezegd dat je komt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You said you're coming."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo a bisa ku bo ta bini."
          }
        }
      }
    },
    "Je hebt het bewijs geverifieerd.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've verified the evidence."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo a verifiká e prueba."
          }
        }
      }
    },
    "Je hebt laten weten dat je niet kunt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You let them know you can't make it."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo a laga nan sa ku bo no por."
          }
        }
      }
    },
    "Je hebt net al een code aangevraagd. Wacht 60 seconden en probeer het opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You just requested a code. Wait 60 seconds and try again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo a pidi un kódigo djis awor. Warda 60 sekonde i purba atrobe."
          }
        }
      }
    },
    "Je hebt nog geen accountpincode. Die kies je zodra je een chat vergrendelt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have an account PIN yet. You choose one as soon as you lock a chat."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo no tin kódigo PIN di kuenta ainda. Bo ta skohe un ora bo bloká un chat."
          }
        }
      }
    },
    "Je hebt nog geen cv of brief. Maak een sollicitatie, dan deel je hem daarna vanuit Mijn sollicitatie.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have a CV or letter yet. Create an application, then share it from My application."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo no tin CV òf karta ainda. Traha un solisitut, despues bo ta kompart'é for di Mi solisitut."
          }
        }
      }
    },
    "Je hebt nog geen plan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have a plan yet"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo no tin plan ainda"
          }
        }
      }
    },
    "Je hebt nog geen profiel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have a profile yet"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo no tin perfil ainda"
          }
        }
      }
    },
    "Je hebt nog geen projecten. Maak er een met de + bij Projecten.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have any projects yet. Create one with the + next to Projects."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo no tin proyekto ainda. Traha un ku e + banda di Proyektonan."
          }
        }
      }
    },
    "Je hebt te vaak geprobeerd. Wacht even en probeer het opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've tried too many times. Wait a moment and try again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo a purba hopi biaha. Warda un ratu i purba atrobe."
          }
        }
      }
    },
    "Je iCloud-e-mailadres en een app-specifiek wachtwoord": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iCloud email address and an app-specific password"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo adrès di e-mail di iCloud i un kontraseña spesífiko pa app"
          }
        }
      }
    },
    "Je iPhone bewaart de code voor je.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone keeps the code for you."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo iPhone ta warda e kódigo pa bo."
          }
        }
      }
    },
    "Je iPhone geeft je Watch toegang tot PAVE.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone gives your Watch access to PAVE."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo iPhone ta duna bo Watch akseso na PAVE."
          }
        }
      }
    },
    "Je kaartje blijft in PAVE. %@ doet niet echt mee: een medespeler bekijkt het als werkgever.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your card stays in PAVE. %@ isn't really taking part: a fellow player views it as the employer."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo karchi ta keda den PAVE. %@ no ta partisipá di bèrdat: un kompañero ta wak e komo dunadó di trabou."
          }
        }
      }
    },
    "Je kaartje blijft in PAVE. %@ doet niet echt mee: in de demo bekijkt een medespeler het als werkgever.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your card stays in PAVE. %@ isn't really taking part: in the demo, a fellow player views it as the employer."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo karchi ta keda den PAVE. %@ no ta partisipá di bèrdat: den e demo, un kompañero ta wak e komo dunadó di trabou."
          }
        }
      }
    },
    "Je kaartje voor %@ staat klaar bij %@. Je krijgt een melding als je wordt uitgenodigd; alles staat in Mijn beursdag.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your card for %@ is ready at %@. You'll get a notification if you're invited; everything is in My fair day."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo karchi pa %@ ta kla na %@. Bo ta haña un notifikashon si nan invitá bo; tur kos ta den Mi dia di feria."
          }
        }
      }
    },
    "Je keuze kon niet worden geladen. Probeer het opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choice couldn't be loaded. Try again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "No por a karga bo eskoho. Purba atrobe."
          }
        }
      }
    },
    "Je keuzes gelden nu alleen op dit toestel. Zodra PAVE er klaar voor is, gelden ze voor je hele account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your choices only apply on this device for now. Once PAVE is ready, they'll apply to your whole account."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo eskohonan ta konta pa awor solamente riba e aparato aki. Ora PAVE ta kla, nan ta konta pa henter bo kuenta."
          }
        }
      }
    },
    "Je kiest uit je kluis; Ayla zoekt daarna opnieuw": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose from your vault; Ayla then searches again"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo ta skohe for di bo kaha fuerte; despues Ayla ta buska atrobe"
          }
        }
      }
    },
    "Je kiest zelf wat %@ ziet en hoe lang. Je kunt het altijd pauzeren of intrekken.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose what %@ sees and for how long. You can always pause or revoke it."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo ta skohe kiko %@ ta mira i pa kuantu tempu. Bo por pousa òf retirá esaki semper."
          }
        }
      }
    },
    "Je kluis heeft nog geen vaardigheden. Voeg er hieronder zelf een toe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault doesn't have any skills yet. Add one yourself below."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo kaha fuerte no tin abilidat ainda. Añadí un bo mes aki bou."
          }
        }
      }
    },
    "Je kluis is niet bereikbaar. Controleer je internetverbinding en probeer het opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your vault can't be reached. Check your internet connection and try again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo kaha fuerte no ta alkansabel. Kontrolá bo konekshon di internet i purba atrobe."
