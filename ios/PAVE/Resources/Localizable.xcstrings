        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla ta usa esaki den bo kombersashonnan riba bo iPhone, web i bo Apple Watch."
          }
        }
      }
    },
    "Ayla gebruikt niets uit deze mappen en stelt niets voor. Wat erin staat, blijft bewaard tot je het wist.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla uses nothing from these folders and suggests nothing. What's in them stays saved until you erase it."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no ta usa nada for di e fòldernan aki i no ta sugerí nada. Loke ta aden ta keda wardá te ora bo borá e."
          }
        }
      }
    },
