    "Chats die langer dan %@ geleden zijn aangemaakt worden verwijderd, ook de bestaande. Dit kan niet ongedaan worden gemaakt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats created more than %@ ago will be deleted, including existing ones. This can't be undone."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats ku a wòrdu kreá mas ku %@ pasá ta wòrdu kitá, tambe esnan ku tin kaba. Esaki no por wòrdu deshasí."
          }
        }
      }
    },
    "Chats die langer dan %@ niet zijn gebruikt worden verwijderd, ook de bestaande. Dit kan niet ongedaan worden gemaakt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats not used for more than %@ will be deleted, including existing ones. This can't be undone."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats ku no a wòrdu usá pa mas ku %@ ta wòrdu kitá, tambe esnan ku tin kaba. Esaki no por wòrdu deshasí."
          }
        }
      }
    },
