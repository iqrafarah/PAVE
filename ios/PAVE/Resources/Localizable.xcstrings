      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Skohe"
          }
        }
      }
    },
    "Kies 4 cijfers. Daarmee open je je vergrendelde chats en e-mails.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose 4 digits. You use them to open your locked chats and emails."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Skohe 4 sifra. Ku nan bo ta habri bo chats i e-mailnan bloká."
          }
        }
      }
    },
    "Kies 4 cijfers. Daarmee open je je vergrendelde chats.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose 4 digits. You use them to open your locked chats."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Skohe 4 sifra. Ku nan bo ta habri bo chats bloká."
          }
        }
      }
    },
    "Kies 4 nieuwe cijfers. Daarmee open je vanaf nu je vergrendelde chats.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose 4 new digits. From now on you use them to open your locked chats."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Skohe 4 sifra nobo. For di awor bo ta habri bo chats bloká ku nan."
          }
        }
      }
    },
    "Kies bij het inloggen 'Wachtwoord vergeten?' en stel een nieuw wachtwoord in. Zo kan alleen jij nog bij je account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When signing in, choose 'Forgot password?' and set a new password. That way only you can access your account."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora bo ta drenta, skohe 'Lubidá kontraseña?' i pone un kontraseña nobo. Asina solamente bo por drenta bo kuenta."
          }
        }
      }
    },
    "Kies de datum.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the date."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Skohe e fecha."
          }
        }
      }
    },
    "Kies de persoon die je bewijs kan bevestigen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
