        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayla no por a skirbi awor. Purba atrobe den un ratu."
          }
        }
      }
    },
    "Ayla leest je bestanden en vult alvast in…": {
      "extractionState": "manual",
      "localizations": {
