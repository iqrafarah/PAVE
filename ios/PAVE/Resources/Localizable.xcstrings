    "iCloud Mail werkt alleen met een @icloud.com-, @me.com- of @mac.com-adres. Je gewone Apple-inlogadres werkt hier niet als het van een andere provider is.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Mail only works with an @icloud.com, @me.com or @mac.com address. Your usual Apple sign-in address won't work here if it's from another provider."
          }
        },
        "pap": {
          "stringUnit": {
