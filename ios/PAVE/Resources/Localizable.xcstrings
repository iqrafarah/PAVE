    "Op dat apparaat moet je daarna opnieuw inloggen. Is PAVE daar nu open, dan kan dat tot een uur duren.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll then have to sign in again on that device. If PAVE is open there now, it can take up to an hour."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Despues bo mester drenta atrobe riba e aparato ei. Si PAVE ta habrí einan awor, esei por tarda te un ora."
          }
        }
      }
    },
