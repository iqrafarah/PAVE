    "Elke keer dat iemand kijkt of downloadt, zie je dat in het logboek. Een naam die een bezoeker invult, controleren we niet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time someone views or downloads, you see it in the log. We don't check a name a visitor enters."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur biaha ku un hende wak òf baha, bo ta mir'é den e registro. Nos no ta kontrolá un nòmber ku un bishitante yena."
          }
        }
      }
    },
    "Email": {
      "extractionState": "manual",
      "localizations": {
