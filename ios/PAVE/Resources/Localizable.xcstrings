    "Kijk mijn plan na: haal ik zo mijn doel? Stel voor wat erbij moet of weg kan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review my plan: will this get me to my goal? Suggest what should be added or can go."
          }
        },
