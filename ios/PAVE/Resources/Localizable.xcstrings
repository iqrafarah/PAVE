    },
    "Je krijgt een melding de dag voor je deadline en een week nadat je Verstuurd zet. De meldingen blijven op dit toestel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll get a notification the day before your deadline and a week after you set it to Sent. The notifications stay on this device."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo ta haña un notifikashon e dia promé ku bo fecha límite i un siman despues ku bo pone riba Mandá. E notifikashonnan ta keda riba e aparato aki."
          }
        }
      }
    },
    "Je krijgt een melding zodra %@ het heeft beoordeeld.": {
      "extractionState": "manual",
      "localizations": {
