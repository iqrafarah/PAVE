            "state": "translated",
            "value": "Algu a bai robes. Purba atrobe den un ratu."
          }
        }
      }
    },
    "Er is geen prullenmand in je mailbox gevonden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trash folder was found in your mailbox."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "No a haña ningun basurero den bo buzon."
          }
        }
      }
    },
    "Er is niemand om aan te antwoorden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no one to reply to."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "No tin ningun hende pa kontestá."
          }
        }
      }
    },
    "Er is nog geen e-mail gekoppeld. Dat doe je bij Meldingen, onder de drie puntjes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No email is connected yet. You do that in Notifications, under the three dots."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda no tin e-mail konektá. Bo ta hasi esei na Notifikashonnan, bou di e tres puntonan."
          }
        }
      }
    },
    "Er is nog niets om te delen. Voeg eerst bewijs toe aan je kluis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's nothing to share yet. First add evidence to your vault."
          }
