    "Alles in PAVE blijft stil staan: geen bewegende overgangen, laders of golven. Geldt alleen op dit apparaat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in PAVE stays still: no moving transitions, loaders or waves. Only applies on this device."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Tur kos den PAVE ta keda keto: no tin transishon, kargadó òf ola ku ta move. Ta konta solamente riba e aparato aki."
          }
        }
      }
    },
