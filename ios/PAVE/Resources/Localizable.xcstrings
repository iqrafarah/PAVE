            "state": "translated",
            "value": "Your answer, in one sentence"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo kontesta, den un frase"
          }
        }
      }
    },
    "Je bent er klaar voor.": {
      "extractionState": "manual",
      "localizations": {
