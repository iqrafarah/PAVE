    "Zet aan of uit wat op je cv staat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on or off what's on your CV."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone òf paga loke ta riba bo CV."
          }
        }
      }
    },
    "Zet aan wat ze mogen zien. Met bestand kunnen ze het bewijs zelf openen, zoals je cijferlijst of diploma.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on what they may see. With file they can open the evidence themselves, such as your grade list or diploma."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone loke nan mag mira. Ku archivo nan por habri e prueba nan mes, manera bo lista di nota òf diploma."
          }
        }
      }
    },
    "Zet de microfoon aan voor PAVE in Instellingen op je Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the microphone for PAVE in Settings on your Apple Watch."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone e mikròfono na pa PAVE den Konfigurashon riba bo Apple Watch."
          }
        }
      }
    },
    "Zet de vaardigheid in je profiel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the skill in your profile."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone e abilidat den bo perfil."
          }
        }
      }
    },
    "Zet deze opleiding als stap in je plan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds this study as a step to your plan"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta pone e estudio aki komo paso den bo plan"
          }
        }
      }
    },
    "Zet diploma's, certificaten en werkervaring in je kluis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put diplomas, certificates and work experience in your vault."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone diploma, sertifikado i eksperensia di trabou den bo kaha fuerte."
          }
        }
      }
    },
    "Zet een filter weer op Alle om meer te zien.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
