    "Ben je even weg uit PAVE, dan vraagt de app daarna weer om je pincode of Face ID. In de appwisselaar zie je alleen het PAVE-logo.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're away from PAVE for a while, the app asks for your PIN or Face ID again. In the app switcher you only see the PAVE logo."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Si bo ta un ratu leu di PAVE, e app ta pidi bo kódigo PIN òf Face ID atrobe. Den e kambiadó di app bo ta mira solamente e logo di PAVE."
          }
        }
      }
    },
