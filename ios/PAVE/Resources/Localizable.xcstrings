          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo petishon a wòrdu mandá. Bo ta haña un notifikashon ora bo prueba a wòrdu evaluá."
          }
        }
      }
    },
    "Je aanvraag ligt bij %@. Je krijgt een melding zodra je bewijs is beoordeeld.": {
