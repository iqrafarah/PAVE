    "Praat met Ayla vanaf je pols. Je Watch krijgt toegang via deze iPhone en je kunt hem altijd weer ontkoppelen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to Ayla from your wrist. Your Watch gets access through this iPhone and you can always disconnect it again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Papia ku Ayla for di bo muñeka. Bo Watch ta haña akseso via e iPhone aki i bo por deskonekt'é atrobe semper."
          }
        }
      }
    },
