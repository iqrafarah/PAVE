          }
        }
      }
    },
    "Je leest zin voor zin mee met wat Ayla zegt, ook op je Apple Watch. Zet je dit uit, dan zie je alleen de orb.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You read along sentence by sentence with what Ayla says, also on your Apple Watch. If you turn this off, you only see the orb."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo ta lesa huntu frase pa frase loke Ayla ta bisa, tambe riba bo Apple Watch. Si bo paga esaki, bo ta mira solamente e orb."
          }
        }
      }
    },
    "Je microfoon staat uit": {
      "extractionState": "manual",
      "localizations": {
