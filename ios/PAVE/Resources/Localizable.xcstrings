    "Je bent offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo ta offline"
          }
        }
      }
    },
    "Je bent offline. Wat je typt blijft staan tot je weer verbinding hebt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. What you type stays until you're connected again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo ta offline. Loke bo tektea ta keda te ora bo tin konekshon atrobe."
          }
        }
      }
    },
    "Je bent op dit apparaat uitgelogd. Dat gebeurt bijvoorbeeld als je wachtwoord is gewijzigd.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been signed out on this device. This happens, for example, when your password has been changed."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo a sali riba e aparato aki. Esaki ta pasa por ehèmpel ora bo kontraseña a kambia."
          }
        }
      }
    },
    "Je bent te lang ingelogd geweest. Log opnieuw in en probeer het dan nog eens.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been signed in for too long. Sign in again and then try again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo a keda drenta pa muchu largu. Drenta atrobe i purba un biaha mas."
          }
        }
      }
    },
    "Je bent uitgenodigd": {
      "extractionState": "manual",
