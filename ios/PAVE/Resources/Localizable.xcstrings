            "state": "translated",
            "value": "Set a filter back to All to see more."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone un filtro bèk riba Tur pa mira mas."
          }
        }
      }
    },
    "Zet een paar opleidingen naast elkaar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a few programmes side by side."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone algun estudio banda di otro."
          }
        }
      }
    },
    "Zet het certificaat in je profiel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the certificate in your profile."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Pone e sertifikado den bo perfil."
          }
        }
      }
    },
