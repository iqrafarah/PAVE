    "Je toegang tot je e-mail is verlopen. Koppel je account opnieuw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your access to your email has expired. Connect your account again."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo akseso na bo e-mail a vense. Konektá bo kuenta atrobe."
          }
        }
      }
    },
    "Je toestel kan de code van 6 cijfers voor je maken. Kies in Wachtwoorden je PAVE-inlog, of voeg een nieuwe toe.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device can create the 6-digit code for you. In Passwords, choose your PAVE login or add a new one."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo aparato por traha e kódigo di 6 sifra pa bo. Den Kontraseñanan, skohe bo login di PAVE òf añadí un nobo."
          }
        }
      }
    },
    "Je verstuurt vanaf %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're sending from %@."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo ta manda for di %@."
          }
        }
      }
    },
    "Je voegt ze na elkaar toe, elk al ingevuld. Eerst %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You add them one after another, each already filled in. First %@."
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo ta añadí nan un tras di otro, kada un yená kaba. Promé %@."
          }
        }
      }
    },
    "Je volgende stap plannen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan your next step"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiká bo siguiente paso"
          }
        }
      }
    },
    "Je voornaam of roepnaam": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first name or nickname"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo nòmber òf nòmber di kariño"
          }
        }
      }
    },
    "Je wachtwoord voldoet aan alle eisen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password meets all the requirements"
          }
        },
        "pap": {
          "stringUnit": {
            "state": "translated",
            "value": "Bo kontraseña ta kumpli ku tur rekisito"
          }
        }
      }
    },
    "Je wachtwoord voldoet nog niet aan alle eisen.": {
      "extractionState": "manual",
      "localizations": {
