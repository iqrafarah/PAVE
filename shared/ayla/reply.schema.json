{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pave.example/ayla/reply.schema.json",
  "title": "Ayla request and reply",
  "description": "The contract between the Ayla brain on the server and every PAVE app (web, iPhone, Watch). See docs/ayla.md.",
  "$defs": {
    "category": {
      "description": "A part of the vault Ayla may ask to use.",
      "enum": ["diplomas", "certificates", "badges", "projects", "workExperience", "internships", "skills", "feedback", "reflections", "other"]
    },
    "device": { "enum": ["watch", "phone", "web"] },
    "memoryCategory": {
      "description": "Where a note about the user belongs. The apps show it as Opleiding, Werk en stages, Doelen, Vaardigheden, Wat je belangrijk vindt, Hoe je wilt werken, Interesses en hobby's or Over jou.",
      "enum": ["education", "work", "goals", "skills", "values", "workStyle", "interests", "personal"]
    },
    "request": {
      "type": "object",
      "required": ["text", "device", "input"],
      "additionalProperties": false,
      "properties": {
        "conversationId": { "type": "string", "description": "Empty for a new conversation." },
        "text": { "type": "string", "minLength": 1 },
        "device": { "$ref": "#/$defs/device" },
        "input": { "enum": ["voice", "text"] },
        "app": {
          "type": "object",
          "description": "How the app is set right now, so Ayla can say how something stands and does not do what is already so. No vault content and no names of folders or evidence.",
          "additionalProperties": false,
          "properties": {
            "theme": { "type": "string", "maxLength": 80 },
            "textSize": { "type": "string", "maxLength": 80 },
            "displayMode": { "type": "string", "maxLength": 80 },
            "vaultLayout": { "type": "string", "maxLength": 80 },
            "voiceText": { "type": "boolean" },
            "animations": { "type": "boolean" },
            "memory": { "type": "boolean" },
            "chatTitle": { "type": "string", "maxLength": 80 },
            "chatPinned": { "type": "boolean" }
          }
        },
        "context": {
          "type": "object",
          "description": "What the user has open. Only ids: the server reads the item itself, and only with consent.",
          "required": ["screen"],
          "additionalProperties": false,
          "properties": {
            "screen": { "$ref": "#/$defs/screen" },
            "itemId": { "type": "string" },
            "itemIds": { "type": "array", "maxItems": 10, "items": { "type": "string" }, "description": "Items the user picked for the conversation: all Ayla then uses of the vault." },
            "vacancy": {
              "type": "object",
              "description": "The vacancy the user has open, as its card shows it, so a question about \"deze\" is about that one.",
              "required": ["title", "company", "matches", "skillGap"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string" },
                "company": { "type": "string" },
                "city": { "type": "string" },
                "summary": { "type": "string" },
                "matches": { "type": "array", "items": { "type": "string" } },
                "skillGap": { "type": "array", "items": { "type": "string" } }
              }
            },
            "compare": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "description": "Two or three vacancies the user picked to compare, each as its card shows it (like vacancy). Needed for task compare.",
              "items": {
                "type": "object",
                "required": ["title", "company", "matches", "skillGap"],
                "additionalProperties": false,
                "properties": {
                  "title": { "type": "string" },
                  "company": { "type": "string" },
                  "city": { "type": "string" },
                  "summary": { "type": "string" },
                  "matches": { "type": "array", "items": { "type": "string" } },
                  "skillGap": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "task": {
              "enum": ["compare", "gaps", "prepare", "interview"],
              "description": "A button on a vacancy, or the practice interview that is going on. compare needs compare; gaps, prepare and interview need vacancy. The app sends interview with every question while the practice lasts."
            }
          }
        },
        "attachments": {
          "type": "array",
          "description": "Files the user added to this message. The app reads the text on the device; the file itself is not sent and the text is not stored.",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["name", "text"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "text": { "type": "string", "minLength": 1, "maxLength": 20000 }
            }
          }
        }
      }
    },
    "screen": {
      "description": "A place in the app. Each app maps it to its own route.",
      "enum": ["home", "chat", "vault", "vaultItem", "addEvidence", "plans", "vacancies", "profile", "settings"]
    },
    "choice": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "description": "Something Ayla does in the app with her answer (ACTIONS in the Ayla function). The app looks names up itself and says so when it cannot carry it out. With confirm, only after the user says Ja.",
      "required": ["do"],
      "additionalProperties": false,
      "properties": {
        "do": {
          "enum": [
            "openSettingsPage", "openMemory", "openSavedVacancies", "openFolder", "back", "close",
            "newChat", "openChat", "renameChat", "pinChat", "archiveChat", "setChatExpiry",
            "setTheme", "setTextSize", "setDisplayMode", "setVaultLayout", "setVoiceText", "setChatsInSearch", "setAnimations", "setMemory",
            "createFolder", "moveToFolder", "archiveEvidence", "allowAyla", "requestVerification",
            "openVacancy", "saveVacancy",
            "openNotifications", "openApplications", "openApplication", "openProject", "setFontStyle",
            "openPlan", "addPlanStep", "markPlanStep", "renamePlanStep", "describePlanStep", "linkPlanToProject", "makeVacancyPlan",
            "addTalkToCalendar", "openMail", "summarizeMail", "replyMail",
            "shareWith", "stopSharing", "showShares",
            "deleteChat", "deleteEvidence", "signOut", "forgetAll", "removePlanStep", "answerInvitation", "addProjectSource"
          ]
        },
        "value": { "type": "string" },
        "target": { "type": "string" },
        "confirm": { "const": true }
      }
    },
    "requirementLink": {
      "type": "object",
      "description": "A skill and the requirement of the vacancy it comes from, so the user can check it.",
      "required": ["skill", "requirement"],
      "additionalProperties": false,
      "properties": {
        "skill": { "type": "string" },
        "requirement": { "type": "string" }
      }
    },
    "vacancy": {
      "type": "object",
      "required": ["id", "title", "company", "source", "matches", "skillGap"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "city": { "type": "string" },
        "employment": { "enum": ["fullTime", "partTime"] },
        "salary": {
          "type": "object",
          "description": "Shown per month in the apps. An estimate is labelled as such.",
          "required": ["min", "max", "period", "currency", "isEstimate"],
          "additionalProperties": false,
          "properties": {
            "min": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 },
            "period": { "enum": ["month", "year"] },
            "currency": { "const": "EUR" },
            "isEstimate": { "type": "boolean" }
          }
        },
        "logoUrl": { "type": "string", "format": "uri" },
        "url": { "type": "string", "format": "uri" },
        "source": { "enum": ["example", "adzuna", "jooble", "web"], "description": "\"example\" vacancies are fictional and must be labelled as examples. \"web\" was found by a web search on a job site." },
        "summary": { "type": "string", "description": "A short piece of the vacancy text, as the source gives it. Never the whole text." },
        "postedAt": { "type": "string", "description": "The day the source last saw it (YYYY-MM-DD), when it says so." },
        "matches": { "type": "array", "items": { "$ref": "#/$defs/requirementLink" } },
        "skillGap": { "type": "array", "items": { "$ref": "#/$defs/requirementLink" } }
      }
    },
    "block": {
      "description": "A card the apps draw. Apps skip a type they do not know yet.",
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "vaultSelection" },
            "categories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["category", "count"],
                "additionalProperties": false,
                "properties": {
                  "category": { "$ref": "#/$defs/category" },
                  "count": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "required": ["categories"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "vacancies" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/vacancy" } },
            "search": {
              "type": "object",
              "description": "What Ayla searched for, so the apps can show it.",
              "required": ["what", "where"],
              "additionalProperties": false,
              "properties": { "what": { "type": "string" }, "where": { "type": "string" }, "also": { "type": "string" } }
            }
          },
          "required": ["items"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "skillSuggestions" },
            "itemId": { "type": "string" },
            "skills": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "reason"],
                "additionalProperties": false,
                "properties": { "name": { "type": "string" }, "reason": { "type": "string" } }
              }
            }
          },
          "required": ["itemId", "skills"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "cv" },
            "profile": { "type": "string" },
            "experience": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "organisation", "period"],
                "additionalProperties": false,
                "properties": {
                  "title": { "type": "string" },
                  "organisation": { "type": "string" },
                  "period": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            },
            "skills": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["profile", "experience", "skills"],
          "additionalProperties": false
        }
      ]
    },
    "reply": {
      "type": "object",
      "required": ["version", "id", "conversationId", "text", "blocks", "usedData"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "text": { "type": "string", "minLength": 1, "description": "What Ayla says. On the Watch one or two sentences." },
        "question": {
          "type": "object",
          "required": ["text", "choices"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string" },
            "choices": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/choice" } }
          }
        },
        "accessRequest": {
          "type": "object",
          "description": "Ayla asks to use parts of the vault for this task. The app asks the user; nothing is used before a grant.",
          "required": ["id", "purpose", "categories"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "purpose": { "type": "string" },
            "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/category" } }
          }
        },
        "planEdit": {
          "type": "object",
          "description": "Changes to the conversation's plan Ayla proposes so it reaches its goal. Nothing is saved: the app shows a card and the user applies what they keep. iPhone only.",
          "required": ["id", "planId", "changes"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "planId": { "type": "string" },
            "changes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["op", "title", "why"],
                "additionalProperties": false,
                "properties": {
                  "op": { "enum": ["add", "remove", "move"] },
                  "stepId": { "type": "string", "description": "The step removed or moved." },
                  "title": { "type": "string" },
                  "kind": { "type": "string" },
                  "afterStepId": { "type": ["string", "null"], "description": "The step it comes after; null: at the start. Not for remove." },
                  "why": { "type": "string" }
                }
              }
            }
          }
        },
        "proposedAction": {
          "type": "object",
          "description": "Something that changes data. It only happens after the user confirms.",
          "required": ["id", "kind", "summary", "expiresAt"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "kind": { "enum": ["addVaultItem", "updatePlan", "createPlan", "draftProfile", "requestValidation"] },
            "summary": { "type": "string" },
            "expiresAt": { "type": "string", "format": "date-time" },
            "planStep": {
              "type": "object",
              "description": "With updatePlan: the step of the conversation's plan Ayla changed. Already saved; the apps show it.",
              "required": ["planId", "stepId", "status"],
              "additionalProperties": false,
              "properties": {
                "planId": { "type": "string" },
                "stepId": { "type": "string" },
                "status": { "enum": ["upcoming", "active", "done", "skipped"] }
              }
            },
            "newPlan": {
              "type": "object",
              "description": "With createPlan: the plan the user asked for. The app saves it and puts the conversation in it.",
              "required": ["name", "goal", "steps"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 80 },
                "goal": { "type": "string", "maxLength": 280 },
                "steps": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "required": ["title", "summary", "kind"],
                    "additionalProperties": false,
                    "properties": {
                      "title": { "type": "string", "minLength": 1, "maxLength": 80 },
                      "summary": { "type": "string", "maxLength": 280 },
                      "kind": { "type": "string" }
                    }
                  }
                }
              }
            },
            "vaultItem": {
              "type": "object",
              "description": "With addVaultItem: what to put in the vault once the user confirms. Dates as YYYY-MM-DD.",
              "required": ["category", "title"],
              "additionalProperties": false,
              "properties": {
                "category": { "$ref": "#/$defs/category" },
                "title": { "type": "string", "minLength": 1, "maxLength": 200 },
                "organisationName": { "type": "string" },
                "organisationLocation": { "type": "string" },
                "startDate": { "type": "string", "format": "date" },
                "endDate": { "type": "string", "format": "date" },
                "issuedOn": { "type": "string", "format": "date" },
                "isCurrent": { "type": "boolean" },
                "description": { "type": "string", "maxLength": 600, "description": "What the user did or achieved, as far as they told it." },
                "skills": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 60 } },
                "attachments": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "description": "Names of the files sent in the conversation that belong to this item." }
              }
            }
          }
        },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "navigation": {
          "type": "object",
          "description": "Open a screen. Needs no confirmation because it changes nothing.",
          "required": ["screen"],
          "additionalProperties": false,
          "properties": {
            "screen": { "$ref": "#/$defs/screen" },
            "itemId": { "type": "string" }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 4,
          "description": "What Ayla does in the app, in order. Only sent to the iPhone app for now.",
          "items": { "$ref": "#/$defs/action" }
        },
        "continues": { "const": true, "description": "She is not done yet: the app sends what came of these actions (results in the request) and she goes on." },
        "memories": {
          "type": "array",
          "description": "Ayla suggests remembering these facts about the user, one per item, and taking away notes they make out of date. The app changes ayla_memories only after the user confirms; nothing is remembered or forgotten by itself.",
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["text", "category"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "maxLength": 300, "description": "The new fact. Empty when Ayla only suggests taking an old note away." },
              "category": { "$ref": "#/$defs/memoryCategory" },
              "replaces": { "type": "string", "minLength": 1, "description": "The exact text of one of the user's notes this makes out of date, such as a previous job. The user decides whether it goes; they may have both." }
            }
          }
        },
        "usedMemories": {
          "type": "array",
          "description": "Set by the server: the notes about the user (from ayla_memories) this answer leans on, so the apps can show what it is based on.",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["text", "category"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "category": { "$ref": "#/$defs/memoryCategory" }
            }
          }
        },
        "usedData": {
          "type": "array",
          "description": "Set by the server: the categories this answer used. Always a subset of what the user allowed.",
          "items": { "$ref": "#/$defs/category" }
        }
      }
    }
  },
  "$ref": "#/$defs/reply"
}
